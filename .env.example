# Copy to .env and fill in. Never commit the real .env.

PORT=3000
DB_HOST=
DB_PORT=3306
DB_USER=
# If the password contains '#', wrap it in single quotes or dotenv will cut it there.
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
JWT_EXPIRES_IN=8h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of the frontend. Used for CORS and for the "Iniciar sesión" link in report emails.
FRONTEND_URL=
# Optional: overrides FRONTEND_URL for the link in emails
APP_URL=

# --- Report emails (the Excel goes to the admin when a cleaner submits a report) ---
# Option A (recommended): Resend over HTTPS. Works on hosts that block SMTP (some Railway plans).
RESEND_API_KEY=
# Sender must be on a domain verified in Resend. Without it, Resend's test sender only delivers to your own Resend account email.
MAIL_FROM="Limpia Cleaning <reportes@limpiacleaning.com>"

# Option B: any SMTP server (used only when RESEND_API_KEY is empty).
# Emails are only sent when MAIL_HOST, MAIL_USER and MAIL_PASS are all set.
MAIL_HOST=
MAIL_PORT=465
# true = implicit TLS (port 465). Use false with port 587 (STARTTLS).
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=

# Who receives the reports. Defaults to admin@limpiacleaning.com.
REPORT_EMAIL_TO=admin@limpiacleaning.com
